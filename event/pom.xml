<?xml version="1.0" encoding="UTF-8"?>
<!--
  Event module: Spring Cloud Bus events exchanged between Articulorium services.

  The platform publishes ResourceEvents when LDP resources change; transform consumes them and
  publishes DocumentEvents; index and triplestore consume those events to keep Solr and the
  SPARQL store in sync. Received events are dispatched to the services' handlers through Spring
  Integration message flows (com.articulorium.event.integration). The module also contributes
  the Kafka health indicator every bus participant reports through Spring Boot Actuator.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.articulorium</groupId>
    <artifactId>parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>event</artifactId>
  <packaging>jar</packaging>

  <name>Articulorium Event Module</name>
  <description>Spring Cloud Bus events and their Spring Integration dispatch flows.</description>

  <dependencies>

    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-bus</artifactId>
    </dependency>

    <!-- Spring Cloud Bus 5 serialises events with Jackson 3 -->
    <dependency>
      <groupId>tools.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <!-- Kafka health indicator -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-health</artifactId>
    </dependency>

    <!-- JsonMapperBuilderCustomizer for the bus event mapping -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-jackson</artifactId>
    </dependency>

    <dependency>
      <groupId>org.apache.kafka</groupId>
      <artifactId>kafka-clients</artifactId>
    </dependency>

    <!-- Spring Integration (Enterprise Integration Patterns) dispatches received bus events -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-integration</artifactId>
    </dependency>

    <!-- ApplicationEventListeningMessageProducer: the bus delivers events as application events -->
    <dependency>
      <groupId>org.springframework.integration</groupId>
      <artifactId>spring-integration-event</artifactId>
    </dependency>

    <dependency>
      <groupId>com.articulorium</groupId>
      <artifactId>domain</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

</project>
