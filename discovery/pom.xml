<?xml version="1.0" encoding="UTF-8"?>
<!--
  Discovery module: the API of the public discovery and presentation layer (discovery-ui).

  Serves the deployment's branding, layout, facets, filters and search precedence to the
  server-rendered Angular application, searches the Solr collection the index service keeps in
  sync (only resources the caller may read are returned: every hit is checked against the
  platform's Web Access Control), describes single resources with a summary of their IIIF export,
  and lists the public resources for sitemaps. It holds no state of its own.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.articulorium</groupId>
    <artifactId>parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>discovery</artifactId>
  <packaging>jar</packaging>

  <name>Articulorium Discovery Module</name>
  <description>Search, configuration and resource API of the public discovery layer.</description>

  <dependencies>

    <!-- locales of the deployment (articulorium.i18n.*), shared with every other service -->
    <dependency>
      <groupId>com.articulorium</groupId>
      <artifactId>i18n-spring-boot-starter</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- HTTP clients towards Solr, the platform and the transform service -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>

    <!-- OpenAPI description (listed by the gateway's Swagger UI) -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Consul configuration and discovery; discovery brings the load balancer that resolves
         http://articulorium-platform and http://articulorium-transform -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-consul-config</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-consul-discovery</artifactId>
    </dependency>

    <!-- native image hints for the Consul client: without them a native service neither
         registers in Consul nor resolves other services -->
    <dependency>
      <groupId>com.articulorium</groupId>
      <artifactId>consul-native</artifactId>
    </dependency>

    <dependency>
      <groupId>com.articulorium</groupId>
      <artifactId>domain</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>process-aot</id>
                <configuration>
                  <profiles>native</profiles>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
