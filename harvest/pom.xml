<?xml version="1.0" encoding="UTF-8"?>
<!--
  Harvest module: harvests records from external repositories (Fedora Commons, DSpace, VIVO and any
  OAI-PMH data provider) and ingests them into the platform.

  The harvest and ingest abstractions (com.articulorium.harvest.core) are plain Java: sources map
  their protocol to a shared record representation, the Harvester pages, retries and moves
  checkpoints, and an ingestor stores the records. The service wires configured sources to the
  platform ingestor, runs them on schedules and exposes an actuator endpoint to run them on demand.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.articulorium</groupId>
    <artifactId>parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>harvest</artifactId>
  <packaging>jar</packaging>

  <name>Articulorium Harvest Module</name>
  <description>Harvests records from Fedora Commons, DSpace, VIVO and OAI-PMH repositories into the platform.</description>

  <dependencies>

    <!-- the actuator endpoint that lists and runs harvests is served over HTTP -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc</artifactId>
    </dependency>

    <!-- HTTP clients towards the sources and the platform -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-restclient</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Consul configuration and discovery; discovery brings the load balancer that resolves
         http://articulorium-platform -->
    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-consul-config</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.cloud</groupId>
      <artifactId>spring-cloud-starter-consul-discovery</artifactId>
    </dependency>

    <!-- native image hints for the Consul client: without them a native service neither
         registers in Consul nor resolves other services -->
    <dependency>
      <groupId>com.articulorium</groupId>
      <artifactId>consul-native</artifactId>
    </dependency>

    <!-- the shared record representation is RDF; Fedora and VIVO answer RDF, SPARQL results -->
    <dependency>
      <groupId>org.apache.jena</groupId>
      <artifactId>jena-arq</artifactId>
    </dependency>

    <dependency>
      <groupId>com.articulorium</groupId>
      <artifactId>domain</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>native</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>process-aot</id>
                <configuration>
                  <profiles>native</profiles>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.graalvm.buildtools</groupId>
            <artifactId>native-maven-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
