{
  "name": "discovery-ui",
  "version": "0.0.0",
  "description": "Articulorium discovery and presentation layer: server-rendered Angular (SSR) with Angular Material and Mirador",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint",
    "i18n:check": "node --test scripts/check-i18n.test.mjs && node scripts/check-i18n.mjs",
    "serve:ssr": "node dist/discovery-ui/server/server.mjs",
    "clean": "rimraf dist"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.2",
    "@angular/compiler": "22.2.2",
    "@angular/core": "22.2.2",
    "@angular/forms": "22.2.2",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.2",
    "@angular/platform-server": "22.2.2",
    "@angular/router": "22.2.2",
    "@angular/ssr": "22.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@mui/material": "9.4.0",
    "@mui/system": "9.4.0",
    "@ngx-translate/core": "18.0.0",
    "express": "5.2.1",
    "material-design-icons-iconfont": "6.7.0",
    "mirador": "4.3.0",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-i18next": "17.0.21",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
    "@types/express": "5.0.3",
    "@types/node": "24.10.1",
    "@types/react": "^19.2.2",
    "angular-eslint": "22.5.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "prettier": "3.9.9",
    "rimraf": "6.1.3",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
