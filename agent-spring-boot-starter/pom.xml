<?xml version="1.0" encoding="UTF-8"?>
<!--
  Agent Spring Boot starter: Spring Boot auto-configuration for the agent library.

  Adding this module to a Spring Boot application gives it an AgentRegistry bean built from every
  Agent bean in the context plus the agents declared under articulorium.agents.definitions, and
  (with Spring Boot Actuator present) an "agents" section in /actuator/info. The agent library
  itself stays plain Java; applications that do not use Spring depend on "agent" directly.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.articulorium</groupId>
    <artifactId>parent</artifactId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>agent-spring-boot-starter</artifactId>
  <packaging>jar</packaging>

  <name>Articulorium Agent Spring Boot Starter</name>
  <description>Spring Boot auto-configuration and configuration properties for the agent library.</description>

  <dependencies>

    <dependency>
      <groupId>com.articulorium</groupId>
      <artifactId>agent</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
    </dependency>

    <!-- the info contributor is only configured when the application uses Actuator -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-actuator</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>

  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <configLocation>${project.basedir}/../agent/checkstyles.xml</configLocation>
          <consoleOutput>true</consoleOutput>
          <violationSeverity>warning</violationSeverity>
          <failOnViolation>true</failOnViolation>
          <linkXRef>false</linkXRef>
        </configuration>
        <executions>
          <execution>
            <id>validate</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

</project>
